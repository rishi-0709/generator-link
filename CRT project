import json
import os

class ContactBook:
    def _init_(self):
        self.contacts = []
        self.filename = "/tmp/contacts.json"  # Save in a writable directory

    def add_contact(self, name, phone, email, address):
        self.contacts.append({"Name": name, "Phone": phone, "Email": email, "Address": address})
        print("\n✅ Contact added successfully!\n")

    def edit_contact(self, index, name, phone, email, address):
        if 0 <= index < len(self.contacts):
            self.contacts[index] = {"Name": name, "Phone": phone, "Email": email, "Address": address}
            print("\n✅ Contact updated successfully!\n")
        else:
            print("\n❌ Invalid index! No contact found at this position.\n")

    def delete_contact(self, index):
        if 0 <= index < len(self.contacts):
            del self.contacts[index]
            print("\n✅ Contact deleted successfully!\n")
        else:
            print("\n❌ Invalid index! No contact found at this position.\n")

    def clear_contacts(self):
        """Deletes all contacts"""
        confirm = input("⚠ Are you sure you want to delete all contacts? (yes/no): ").strip().lower()
        if confirm == "yes":
            self.contacts = []
            print("\n✅ All contacts deleted successfully!\n")
        else:
            print("\n❌ Action canceled.\n")

    def display_contacts(self):
        if not self.contacts:
            print("\n📂 No contacts available.\n")
        else:
            print("\n📖 Contact List:")
            print("=" * 70)
            print(f"{'Index':<6}{'Name':<20}{'Phone':<15}{'Email':<25}{'Address'}")
            print("=" * 70)
            for i, contact in enumerate(self.contacts):
                print(f"{i:<6}{contact['Name']:<20}{contact['Phone']:<15}{contact['Email']:<25}{contact['Address']}")
            print("=" * 70)

    def search_contact(self, query):
        """Search contacts by name or phone number"""
        results = [c for c in self.contacts if query.lower() in c["Name"].lower() or query in c["Phone"]]
        if results:
            print("\n🔍 Search Results:")
            print("=" * 70)
            print(f"{'Index':<6}{'Name':<20}{'Phone':<15}{'Email':<25}{'Address'}")
            print("=" * 70)
            for i, contact in enumerate(results):
                print(f"{i:<6}{contact['Name']:<20}{contact['Phone']:<15}{contact['Email']:<25}{contact['Address']}")
            print("=" * 70)
        else:
            print("\n❌ No contacts found matching your search.\n")

    def sort_contacts(self):
        """Sort contacts alphabetically by name"""
        self.contacts.sort(key=lambda x: x["Name"].lower())
        print("\n✅ Contacts sorted successfully!\n")

    def save_to_file(self):
        """Saves contacts to a writable directory"""
        try:
            with open(self.filename, "w") as f:
                json.dump(self.contacts, f, indent=4)
            print("\n💾 Contacts saved successfully!\n")
        except PermissionError:
            print("\n❌ Error: Cannot save file! Check file permissions.\n")

    def load_from_file(self):
        """Loads contacts from a writable directory"""
        try:
            if os.path.exists(self.filename):
                with open(self.filename, "r") as f:
                    self.contacts = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            self.contacts = []

def get_valid_index(max_index):
    """Helper function to get a valid index from the user."""
    while True:
        try:
            index = int(input("Enter contact index: "))
            if 0 <= index < max_index:
                return index
            else:
                print(f"❌ Invalid index! Enter a number between 0 and {max_index - 1}.")
        except ValueError:
            print("❌ Invalid input! Please enter a valid number.")

if _name_ == "_main_":
    book = ContactBook()
    book.load_from_file()
    
    while True:
        print("\n📞 Contact Book")
        print("1️⃣  Add Contact")
        print("2️⃣  Edit Contact")
        print("3️⃣  Delete Contact")
        print("4️⃣  Display Contacts")
        print("5️⃣  Search Contact")
        print("6️⃣  Sort Contacts")
        print("7️⃣  Clear All Contacts")
        print("8️⃣  Save and Exit")
        
        choice = input("\nEnter choice: ").strip()

        if choice == "1":
            name = input("Enter name: ").strip()
            phone = input("Enter phone: ").strip()
            email = input("Enter email: ").strip()
            address = input("Enter address: ").strip()
            if name and phone and email and address:
                book.add_contact(name, phone, email, address)
            else:
                print("\n❌ Error: All fields are required!")

        elif choice == "2":
            if not book.contacts:
                print("\n📂 No contacts to edit.\n")
            else:
                book.display_contacts()
                index = get_valid_index(len(book.contacts))
                name = input("Enter new name: ").strip()
                phone = input("Enter new phone: ").strip()
                email = input("Enter new email: ").strip()
                address = input("Enter new address: ").strip()
                book.edit_contact(index, name, phone, email, address)

        elif choice == "3":
            if not book.contacts:
                print("\n📂 No contacts to delete.\n")
            else:
                book.display_contacts()
                index = get_valid_index(len(book.contacts))
                book.delete_contact(index)

        elif choice == "4":
            book.display_contacts()

        elif choice == "5":
            query = input("Enter name or phone to search: ").strip()
            book.search_contact(query)

        elif choice == "6":
            book.sort_contacts()

        elif choice == "7":
            book.clear_contacts()

        elif choice == "8":
            book.save_to_file()
            print("\n✅ Exiting program... Goodbye!\n")
            break

        else:
            print("\n❌ Invalid choice! Please enter a number between 1 and 8.\n")
